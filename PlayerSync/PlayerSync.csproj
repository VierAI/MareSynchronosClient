<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors></Authors>
    <Company></Company>
    <Version>1.15.6.301</Version>
    <Description></Description>
    <Copyright></Copyright>
    <PackageProjectUrl>https://github.com/MareSynchronos/client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VierAI/MareSynchronosClient</RepositoryUrl><!-- public builds: SourceLink points at the public repo -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(PSyncInternal)' == 'true'">
    <DefineConstants>$(DefineConstants);PSYNC_INTERNAL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
	  <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockfileAssemblies>true</CopyLocalLockfileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="PlayerData\Export\**" />
    <EmbeddedResource Remove="PlayerData\Export\**" />
    <None Remove="PlayerData\Export\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MareSempiterne.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Brio.API" Version="3.0.1" />
    <PackageReference Include="DalamudPackager" Version="15.0.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Downloader" Version="4.0.3" />
    <PackageReference Include="K4os.Compression.LZ4.Legacy" Version="1.3.8" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Meziantou.Analyzer" Version="2.0.250">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Glamourer.Api" Version="2.8.0" />
    <PackageReference Include="NReco.Logging.File" Version="1.2.2" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
    <PackageReference Include="Penumbra.String" Version="1.0.8" />
    <PackageReference Include="Loci.Api" Version="0.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.15.0.120848">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Stagehand.Api" Version="0.5.5" />
    <PackageReference Include="Stagehand.Definitions" Version="0.5.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MareSempiterne</AssemblyName>
  </PropertyGroup>

  <!-- Fork 1.15.6.207: append the git commit (short SHA) to SourceRevisionId, so the informational version reads
       1.15.6.N+build<time>.g<sha>. No git or not a repo: unchanged.
       1.15.6.208: stderr is discarded and only a plain hex SHA (^[0-9a-f]{7,40}$) is used; "-dirty" when tracked files differ from HEAD. -->
  <PropertyGroup>
    <PSyncNullDevice Condition="$([MSBuild]::IsOSPlatform('Windows'))">nul</PSyncNullDevice>
    <PSyncNullDevice Condition="'$(PSyncNullDevice)' == ''">/dev/null</PSyncNullDevice>
  </PropertyGroup>
  <Target Name="PSyncAddGitSha" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <Exec Command="git rev-parse --short=8 HEAD 2&gt;$(PSyncNullDevice)" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="PSyncGitSha" />
      <Output TaskParameter="ExitCode" PropertyName="PSyncGitExit" />
    </Exec>
    <PropertyGroup>
      <PSyncGitSha>$(PSyncGitSha.Trim())</PSyncGitSha>
      <PSyncGitShaOk>false</PSyncGitShaOk>
      <PSyncGitShaOk Condition="'$(PSyncGitExit)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(PSyncGitSha)', '^[0-9a-f]{7,40}$'))">true</PSyncGitShaOk>
    </PropertyGroup>
    <Exec Condition="'$(PSyncGitShaOk)' == 'true'" Command="git status --porcelain --untracked-files=no 2&gt;$(PSyncNullDevice)" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="PSyncGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="PSyncGitStatusExit" />
    </Exec>
    <PropertyGroup Condition="'$(PSyncGitShaOk)' == 'true'">
      <PSyncGitSuffix>.g$(PSyncGitSha)</PSyncGitSuffix>
      <PSyncGitSuffix Condition="'$(PSyncGitStatusExit)' == '0' And '$(PSyncGitStatus.Trim())' != ''">$(PSyncGitSuffix)-dirty</PSyncGitSuffix>
      <SourceRevisionId>$(SourceRevisionId)$(PSyncGitSuffix)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MareAPI\MareSynchronosAPI\MareSynchronos.API.csproj" />
    <ProjectReference Include="..\PlayerSync.Validation\PlayerSync.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CheapLoc">
      <HintPath>$(DalamudLibPath)CheapLoc.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Changelogs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Localization\de.json" />
    <EmbeddedResource Include="Localization\fr.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="FileCache\Migrations\" />
  </ItemGroup>
  <Target Name="IncludeDalamudForEfMigration" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveAssemblyReferences" Condition="'$(EFMigrationBuild)' == 'true'">
    <ItemGroup>
      <Reference Update="Dalamud">
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
  <!-- Fork: PlayerSync.Validation references the VFXEditor submodule, whose VFXEditor.json (a Content item) is copied
       transitively into our output and then zipped by DalamudPackager. Keep it out of the output and the plugin zip. -->
  <Target Name="ExcludeVfxEditorManifest" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(Filename)%(Extension)' == 'VFXEditor.json'" />
      <_TransitiveItemsToCopyToOutputDirectory Remove="@(_TransitiveItemsToCopyToOutputDirectory)" Condition="'%(Filename)%(Extension)' == 'VFXEditor.json'" />
      <AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)" Condition="'%(Filename)%(Extension)' == 'VFXEditor.json'" />
    </ItemGroup>
    <Delete Files="$(OutDir)VFXEditor.json" />
  </Target>
</Project>